%% Component diagram (draft) - DIP-8
flowchart TB
    subgraph FE["Web client · TypeScript, React, Vite, Three.js / React Three Fiber · browser (Muzaffar)"]
        direction TB
        PAGES["Pages<br/><i>catalogue, product card,<br/>account &amp; projects</i>"]
        EDITOR["3D Room Editor<br/><i>room, doors/windows, drag/rotate,<br/>wall snap, top-down &amp; free camera</i>"]
        ASSETS["Asset loader<br/><i>GLB + Draco, LOD,<br/>parametric models</i>"]
        STORE["State store"]
        CLIENT["API client<br/><i>generated from OpenAPI</i>"]
        PAGES --> STORE
        EDITOR <--> STORE
        EDITOR --> ASSETS
        STORE --> CLIENT
    end

    subgraph API["Core API · Go, net/http, hexagonal architecture (Sultanbek)"]
        direction TB
        HTTP["HTTP adapter<br/><i>REST handlers, auth,<br/>OpenAPI contract</i>"]
        CATS["Catalogue service<br/><i>search, filters</i>"]
        PROJ["Projects service<br/><i>users, rooms, layouts</i>"]
        LAYOUT["Layout module<br/><i>AABB/OBB collision checks,<br/>walkways, doors, windows;<br/>constraint-based auto-layout</i>"]
        RECA["Recommendation port<br/><i>ML client + baseline fallback</i>"]
        REPO["Repository adapters<br/><i>PostgreSQL, Redis, S3</i>"]
        HTTP --> CATS
        HTTP --> PROJ
        HTTP --> LAYOUT
        HTTP --> RECA
        CATS --> REPO
        PROJ --> REPO
    end

    subgraph ML["ML service · Python, FastAPI, PyTorch, Hugging Face (Tamerlan)"]
        direction TB
        MLAPI["ML API"]
        EMB["Embedding module<br/><i>CLIP image + text vectors</i>"]
        RANK["Ranker<br/><i>room size, budget,<br/>already chosen items</i>"]
        NLQ["Query parser<br/><i>text → structured filters</i>"]
        MLAPI --> RANK
        MLAPI --> NLQ
        RANK --> EMB
    end

    subgraph ETL["Catalogue pipeline · Python (Sultanbek)"]
        PARSE["Store parsers<br/><i>mebel.kz and others</i>"]
        NORM["Normaliser<br/><i>dimensions, materials,<br/>colour, price, dedup</i>"]
        PARSE --> NORM
    end

    DB[("PostgreSQL + pgvector<br/><i>users, rooms, projects,<br/>catalogue, embeddings</i>")]
    CACHE[("Redis<br/><i>query cache</i>")]
    S3[("MinIO (S3)<br/><i>images, GLB models</i>")]
    STORES["Kazakhstan furniture stores<br/>(external)"]

    CLIENT -- "REST / JSON over HTTPS" --> HTTP
    ASSETS -- "GET images / .glb" --> S3
    RECA -- "REST / JSON (internal)" --> MLAPI
    REPO --> DB
    REPO --> CACHE
    REPO --> S3
    EMB --> DB
    NORM --> DB
    NORM --> S3
    PARSE --> STORES

