%% Use case diagram - DIP-8 (Mermaid has no native UML use case type;
%% actors are drawn as people, use cases as ovals, «include»/«extend» as labelled edges)
flowchart LR
    user(("👤<br/>Home user"))
    admin(("👤<br/>Catalog admin"))
    llm(("🤖<br/>LLM API<br/>(external)"))

    subgraph SYS["Arca"]
        direction TB
        UC01(["UC-01 Set up room<br/>(dimensions, doors, windows)"])
        UC02(["UC-02 View and navigate<br/>room in 3D"])
        UC03(["UC-03 Browse and filter<br/>furniture catalog"])
        UC04(["UC-04 Get AI furniture<br/>recommendations"])
        UC05(["UC-05 Place / move / rotate /<br/>remove furniture"])
        UC06(["UC-06 Generate automatic<br/>layout"])
        UC07(["UC-07 Validate layout<br/>(collisions, bounds, clearance)"])
        UC08(["UC-08 View cost summary<br/>vs. budget"])
        UC09(["UC-09 Save / load project"])
        UC10(["UC-10 Describe wishes<br/>in natural language"])
        UC12(["UC-12 Find similar items<br/>to chosen furniture"])
        UC11(["UC-11 Manage catalog<br/>(imports, prices, 3D models)"])
    end

    user --- UC01
    user --- UC02
    user --- UC03
    user --- UC04
    user --- UC05
    user --- UC06
    user --- UC08
    user --- UC09
    user --- UC10
    user --- UC12
    admin --- UC11

    UC04 -. "«include»" .-> UC03
    UC05 -. "«include»" .-> UC07
    UC06 -. "«include»" .-> UC07
    UC10 -. "«extend»" .-> UC04
    UC12 -. "«extend»" .-> UC04
    UC10 --- llm

    classDef actor fill:#fff,stroke:#333,color:#111
    classDef uc fill:#e8f1fb,stroke:#1168bd,color:#111
    classDef later fill:#f3f3f3,stroke:#999,color:#555,stroke-dasharray: 4 3
    class user,admin,llm actor
    class UC01,UC02,UC03,UC04,UC05,UC06,UC07,UC08,UC09,UC11,UC12 uc
    class UC10 later
