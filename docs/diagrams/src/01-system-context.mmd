%% System context diagram (C4 level 1) - DIP-8
flowchart LR
    user["👤 Home user<br/><i>Furnishes a room: sets up the room,<br/>picks furniture, arranges it in 3D</i>"]
    designer["👤 Interior designer / seller<br/><i>Shows clients a layout quickly</i>"]
    admin["👤 Catalog administrator<br/><i>Runs catalogue imports,<br/>fixes data, uploads 3D models</i>"]

    system[["<b>Arca</b><br/><i>Web system for AI-assisted<br/>furniture selection and<br/>3D room planning</i>"]]

    stores["🏬 Kazakhstan online furniture stores<br/><i>[External] e.g. mebel.kz: product pages<br/>with dimensions, prices, images</i>"]
    models["🧊 3D model sources<br/><i>[External] seller GLB models,<br/>CC0 libraries</i>"]
    hf["🤗 Open-source ML models<br/><i>[External] CLIP-family models<br/>(Hugging Face), downloaded once</i>"]
    llm["🤖 LLM API<br/><i>[External, optional] parses free-text<br/>requests into filters</i>"]

    user -- "Room, style, budget, text requests;<br/>edits layout (HTTPS, browser)" --> system
    system -- "3D scene, recommendations<br/>with explanations, cost summary" --> user
    designer -- "Same as home user" --> system
    admin -- "Catalogue management" --> system
    system -- "Parsers (HTTP, robots.txt,<br/>rate-limited)" --> stores
    models -- "GLB files" --> system
    hf -- "Model weights" --> system
    system -. "Prompt → structured filters" .-> llm

    classDef person fill:#08427b,stroke:#052e56,color:#fff
    classDef sys fill:#1168bd,stroke:#0b4884,color:#fff
    classDef ext fill:#999,stroke:#6b6b6b,color:#fff
    class user,designer,admin person
    class system sys
    class stores,models,hf,llm ext
