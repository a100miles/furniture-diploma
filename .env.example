# Copy to .env and adjust. Never commit .env.

# Backend
CORS_ORIGINS=http://localhost:5173
# Planned (DIP-17): PostgreSQL connection
DATABASE_URL=postgresql://planner:change-me@localhost:5432/planner
# Planned (DIP-24, optional): LLM provider key for natural-language requests
LLM_API_KEY=your-api-key-here

# Frontend (Vite)
# Leave empty to use the dev-server proxy; set for a deployed backend.
VITE_API_URL=
VITE_API_PROXY=http://localhost:8000
